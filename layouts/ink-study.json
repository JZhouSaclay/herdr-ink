{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    18,
    18
  ],
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 264
      },
      "min": 76,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 56
          },
          "window_drag": true,
          "content": {
            "mod": "ink-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "ink-spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "ink-agents"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "ink-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "ink-sidebar-seam",
      "type": "block",
      "size": {
        "px": 4
      },
      "min": 4,
      "max": 4,
      "content": {
        "mod": "ink-chrome",
        "props": {
          "separator": "vertical"
        }
      }
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 60
          },
          "window_drag": true,
          "content": {
            "mod": "ink-tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": [
            8,
            12
          ],
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 0,
                  "background": "#fcfcf900",
                  "lone": true,
                  "header": {
                    "content": {
                      "mod": "ink-pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ]
            }
          ],
          "background": {
            "image": "mods/ink-chrome/art/landscape-v11.png",
            "fit": "cover"
          }
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "ink-status"
          }
        }
      ]
    }
  ],
  "theme": "ink-study",
  "ui_font": "LXGW WenKai Mono",
  "font": "Hede Ink Mono",
  "font_size": 14,
  "terminal_opacity": 0.24,
  "preview": "layouts/ink-study.png",
  "cloned_from": {
    "name": "main",
    "version": "0.1.13"
  }
}
